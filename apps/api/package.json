{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "pnpm run build && { tsc -p tsconfig.build.json --watch --preserveWatchOutput & trap \"kill $! 2>/dev/null\" EXIT INT TERM; node --env-file-if-exists=.env --enable-source-maps --watch dist/main.js; }",
    "worker": "pnpm run build && { tsc -p tsconfig.build.json --watch --preserveWatchOutput & trap \"kill $! 2>/dev/null\" EXIT INT TERM; node --env-file-if-exists=.env --enable-source-maps --watch dist/worker.js; }",
    "test": "vitest run --passWithNoTests --fsModuleCachePath=node_modules/.vitest-cache",
    "test:integracao": "vitest run --config vitest.integracao.config.ts --fsModuleCachePath=node_modules/.vitest-cache-integracao",
    "seed": "pnpm run build && node --env-file-if-exists=.env --enable-source-maps dist/cli/seed.js",
    "seed:admin": "pnpm run build && node --env-file-if-exists=.env --enable-source-maps dist/cli/seed-admin.js",
    "reconfigurar-segundo-fator": "pnpm run build && node --env-file-if-exists=.env --enable-source-maps dist/cli/reconfigurar-segundo-fator.js",
    "prisma": "prisma",
    "migrar": "prisma migrate deploy && node dist/cli/migrar-pg-boss.js"
  },
  "dependencies": {
    "@bairrin/contratos": "workspace:*",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/throttler": "6.8.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nestjs": "11.15.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.2",
    "nodemailer": "10.6.1",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
