# Modelo das variáveis da API. Copie para apps/api/.env (fora do git) e ajuste se precisar.
# Todos os valores aqui são fictícios ou credenciais públicas do Postgres e do Mailpit locais
# (infra/docker-compose.yml). Nenhum segredo real entra neste arquivo nem no repositório:
# em homologação e produção os valores ficam só nos segredos do Fly.
# A API valida tudo na subida e não sobe se faltar alguma variável.

NODE_ENV=development
PORTA=3000

# Banco: dois papéis (infra/postgres/init/01-papeis.sql).
# Aplicação: papel bairrin_app, só DML, sem posse de schema.
DATABASE_URL=postgresql://bairrin_app:dev_app_somente_local@127.0.0.1:5432/bairrin
# Migrações: papel bairrin_migracao, dono dos schemas. Em produção só existe no release_command.
# O prisma.config.ts fixa `?schema=migracoes` (tabela de controle do Prisma fora de public).
DATABASE_URL_MIGRACAO=postgresql://bairrin_migracao:dev_migracao_somente_local@127.0.0.1:5432/bairrin
# Testes de integração: Postgres de teste (porta 5433, dados em memória), papel da aplicação.
DATABASE_URL_TESTE=postgresql://bairrin_app:dev_app_somente_local@127.0.0.1:5433/bairrin_teste
# Testes de integração: papel de migração no Postgres de teste. O globalSetup apaga o que esse
# papel criou e aplica as migrações a cada execução; só aceita banco terminado em "_teste".
DATABASE_URL_MIGRACAO_TESTE=postgresql://bairrin_migracao:dev_migracao_somente_local@127.0.0.1:5433/bairrin_teste

# Origens aceitas pelo CORS, separadas por vírgula (o painel em dev roda no Vite, porta 5173).
CORS_ORIGENS=http://localhost:5173

# Chaves: no mínimo 32 bytes cada, uma diferente da outra.
# Os valores abaixo são EXEMPLOS que só servem em desenvolvimento local; nunca os use fora dele.
# Para gerar uma chave real: openssl rand -base64 32
JWT_SEGREDO=EXEMPLOsomenteDEVnaoUSEemPRODjwt0000000000A=
CHAVE_CIFRAGEM_DADOS=EXEMPLOsomenteDEVnaoUSEemPRODcifra00000000A=
CHAVE_HMAC=EXEMPLOsomenteDEVnaoUSEemPRODhmac000000000A=

# E-mail: em dev vai para o Mailpit local (caixa em http://127.0.0.1:8025).
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_REMETENTE=nao-responda@bairrin.com.br

# Vazio desliga o Sentry (padrão em dev).
SENTRY_DSN=

# trace, debug, info, warn, error ou fatal.
LOG_NIVEL=info
