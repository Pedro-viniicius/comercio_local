{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ESM com resolução do Node, como no template ESM do Nest 12.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Imports relativos com extensão .ts; o tsc reescreve para .js no build.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // Decorators legados do Nest e metadados para a injeção de dependência.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "types": ["node"]
  },
  "include": ["src", "test", "prisma", "*.config.ts"]
}
