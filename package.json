{
  "name": "bairrin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.22.2 <23",
    "pnpm": ">=12.4.1"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test && node --test \"scripts/**/*.test.mjs\"",
    "test:integracao": "pnpm -r --if-present run test:integracao",
    "build": "pnpm -r run build",
    "deps:verificar": "depcruise apps packages --config .dependency-cruiser.cjs",
    "migracoes:verificar": "node scripts/verificar-migracoes.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.0"
  }
}
